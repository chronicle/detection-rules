rule sap_logon_failed_invalid_client {
  meta:
    author = "Google Cloud Security"
    name = "SAP - Failed Logon Attempt to Invalid Client"
    description = "Detects failed internal SAP logon attempts (AU2) targeting an invalid or non-existent client, indicating potential misconfiguration or an unauthorized access probe."
    severity = "Medium"
    tactic = "TA0001"
    technique = "T1110"

  events:
    $e.metadata.vendor_name = "SAP"
    $e.metadata.log_type = "SAP_SECURITY_AUDIT"
    $e.additional.fields["msg_1"] = "AU2"

    // Capturing reason=100 from description as an indicator of invalid client failure
    re.regex($e.metadata.description, `reason=100`) nocase

    $client = $e.target.resource.attribute.labels["slgmand_1"]
    $ip = $e.principal.ip

    $client != ""
    $ip != ""

  match:
    $client, $ip over 15m

  outcome:
    $risk_score = 65
    $event_count = count_distinct($e.metadata.id)
    $sap_client = array_distinct($client)
    $terminal_ip = array_distinct($ip)
    $terminal_names = array_distinct($e.principal.hostname)
    $source_user = array_distinct($e.principal.user.userid)
    $event_description = array_distinct($e.metadata.description)
    $target_sid = array_distinct($e.target.application)
    $audit_class = array_distinct($e.security_result.summary)

  condition:
    $e and $event_count >= 3
}
