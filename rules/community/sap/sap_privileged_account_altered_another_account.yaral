rule sap_privileged_account_altered_another_account {

  meta:
    author = "Google Cloud Security"
    description = "A privileged SAP account modified the master record of a different user"
    severity = "High"
    tactic = "TA0003"
    technique = "T1098"

  events:
    $e.metadata.log_type = "SAP_SECURITY_AUDIT"

    $e.additional.fields["msg_1"] =
      /^(AU7|AU8|AU9|AUA|AUB|AUD|BU2)$/
    $e.principal.user.userid in %SAP_PrivilegedUsers.userid

    $e.principal.user.userid = $user
    $e.target.application = $system_id
    $e.target.resource.attribute.labels["slgmand_1"] = $client_id

  match:
    $user, $system_id, $client_id over 75m

  outcome:
    $risk_score = 85
    $message_ids = array_distinct($e.additional.fields["msg_1"])
    $changed_users =
      array_distinct(
        if(
          $e.additional.fields["msg_1"] = "BU2",
          $e.additional.fields["param2_1"],
          $e.additional.fields["param1_1"]
        )
      )

  condition:
    $e
}
