rule sap_privileged_account_master_record_modified {

  meta:
    author = "Google Cloud Security"
    description = "A privileged SAP account's user master record or authorizations were modified"
    severity = "high"
    tactic = "TA0003"
    technique = "T1098"

  events:
    $e.metadata.log_type = "SAP_SECURITY_AUDIT"

    (
      $e.additional.fields["msg"] = /^(AU7|AU8|AU9|AUA|AUB|AUD|BU2)$/ or
      $e.additional.fields["msg_1"] = /^(AU7|AU8|AU9|AUA|AUB|AUD|BU2)$/
    )

    not $e.principal.user.userid in %SAP_ChangeUserMasterDataExcludedUsers.userid


    $target_user = $e.additional.fields["param1"]
    $target_user_1 = $e.additional.fields["param1_1"]

    (
      $target_user in %SAP_PrivilegedUsers.userid or
      $target_user_1 in %SAP_PrivilegedUsers.userid
    )

    $user = strings.coalesce($e.additional.fields["param1_1"], $e.additional.fields["param1"])

  match:
    $user over 30m


  outcome:
    $risk_score = 65
    $changed_user = array_distinct($target_user)
    $changed_user_1 = array_distinct($target_user_1)
    $sap_instance = array_distinct($e.target.resource.name)
    $system_id = array_distinct($e.target.application)
    $ip = array_distinct($e.principal.ip)
    $host = array_distinct($e.principal.hostname)

  condition:
    $e
}
