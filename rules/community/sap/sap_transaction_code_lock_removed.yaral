rule sap_transaction_code_lock_removed {

  meta:
    author = "Google Cloud Security"
    description = "A transaction code lock was removed through message ID AUQ"
    severity = "Medium"
    tactic = "TA0005"
    technique = "T1562.001"

  events:
    $e.metadata.log_type = "SAP_SECURITY_AUDIT"

    $e.additional.fields["msg_1"] = "AUQ"

    $e.additional.fields["param1_1"] = $transaction_code
    $e.principal.user.userid = $user
    $e.target.application = $system_id

  match:
    $user, $transaction_code, $system_id over 30m

  outcome:
    $instance = array_distinct($e.target.resource.name)
    $message_text = array_distinct($e.metadata.description)
    $host = array_distinct($e.principal.hostname)
    $terminal_ips = array_distinct($e.principal.ip)

  condition:
    $e
}
