rule CredentialAccess_CmdkeyCachedCredsRecon_WindowsSysmon
 {
  meta:
    subject = "Cmdkey cached creds recon"
    author = "Cywarden"
    description = "Detects post reconnaissance of cached credentials using the cmdkey utility"
    severity = "High"
    mitre_category = "Credential Access"
    mitre_technique_id = "T1003"
    rule_creation_date = "11-05-2024" //MM-DD-YYYY
    rule_modification_date = ""
    reference1 = "https://detection.fyi/sigmahq/sigma/windows/process_creation/proc_creation_win_cmdkey_recon/"
    reference2 = "https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_cmdkey_recon.yml"
    version = "1.0.0"

  events:
    $cmdkey.metadata.vendor_name = "Microsoft"
    $cmdkey.metadata.product_event_type = "1" //process creation
    // Match cmdkey.exe with any arguments that follow a standard parameter format
    re.regex($cmdkey.target.process.file.full_path, `cmdkey\.exe`) 

    // Adding credentials with cmdkey /add 
    re.regex($cmdkey.target.process.command_line, `-l`) or

    // Listing or dumping credentials with cmdkey /list
    re.regex($cmdkey.target.process.command_line, `\/list`)  
    
    $cmdkey.principal.namespace = $customer

  outcome:
    $risk_score = 64
    $principal_userid = array_distinct($cmdkey.principal.user.userid)
     
    
  condition:
    $cmdkey
}
