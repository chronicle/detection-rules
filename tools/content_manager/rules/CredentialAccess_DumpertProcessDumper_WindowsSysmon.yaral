rule CredentialAccess_DumpertProcessDumper_WindowsSysmon {
    meta:
        name = "HackTool - Dumpert Process Dumper Default File"
        author = "Cywarden"
        description = "Detects the creation of the default dump file used by Outflank Dumpert tool, which dumps the LSASS process memory"
        severity = "Critical"
        mitre_category = "Credential Access"
        mitre_technique_id = "T1003"
        rule_creation_date = "2025-01-29"
        rule_modification_date = ""
        reference = "https://github.com/SigmaHQ/sigma/blob/master/rules/windows/file/file_event/file_event_win_hktl_dumpert.yml"
        version = "1.0.0"

    events:
        $dumpert.metadata.vendor_name = "Microsoft"
        $dumpert.metadata.product_event_type = "11" // Sysmon Event ID for File Creation

        re.regex($dumpert.target.file.full_path, `dumpert\.dmp$`) nocase // Detects the specific dump file

        $dumpert.principal.namespace = $customer

    outcome:
        $risk_score = 90

    condition:
        $dumpert
}
