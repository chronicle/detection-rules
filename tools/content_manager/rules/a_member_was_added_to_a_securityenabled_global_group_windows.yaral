rule a_member_was_added_to_a_securityenabled_global_group_windows {
 meta:
    author = "Nayan Bhattarai"
    description = "Detects activity when a member is added to a security-enabled global group."
    license = "https://github.com/Neo23x0/sigma/blob/master/LICENSE.Detection.Rules.md"
    reference = "https://www.cisecurity.org/controls/cis-controls-list/, https://www.pcisecuritystandards.org/documents/PCI_DSS_v3-2-1.pdf, https://nvlpubs.nist.gov/nistpubs/CSWP/NIST.CSWP.04162018.pdf, https://www.ultimatewindowssecurity.com/securitylog/encyclopedia/event.aspx?eventID=4728, https://www.ultimatewindowssecurity.com/securitylog/encyclopedia/event.aspx?eventID=632"
    version = "0.01"
    sigma_id = "c43c26be-2e87-46c7-8661-284588c5a53e"
    status = "stable"
    tags = "attack.privilege-escalation, attack.persistence, attack.t1098"
    falsepositives = "Unknown"
    severity = "low"
    created = "2025-12-15"
    product = "windows"
    service = "security"

  events:
    $security.metadata.log_type = "WINEVTLOG"
    ($security.metadata.product_event_type = "4728" or $security.metadata.product_event_type = "632")
    // target.group.group_display_name = "DLP - Centres"

  condition:
    $security
}
