rule   credentialAccess_HarvestingOfWifiCredentialsViaNetsh_windows{
  meta:
    author = "Ruledev2"
    description = "Detect the harvesting of wifi credentials using netsh.exe"
    severity = "MEDIUM"
    created = "2024-01-31"
    product = "microsoft"
    tag = "credential_access"
    service = "process_creation"
    status = "under development"
    Reference = "https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_netsh_wifi_credential_harvesting.yml"
    mitre = "credential_access,t1040"

  events:
     $security.metadata.event_type = "PROCESS_LAUNCH" and 
    ((re.regex($security.target.process.file.full_path, `.*\\netsh\.exe`) nocase) or 
    ($security.target.file.full_path = "netsh.exe" nocase)) and 
    (re.regex($security.target.process.command_line, `.*wlan.*`) nocase) and 
    (re.regex($security.target.process.command_line, `.* s.*`) nocase) and 
    (re.regex($security.target.process.command_line, `.* p.*`) nocase) and 
    (re.regex($security.target.process.command_line, `.* k.*`) nocase) and 
    (re.regex($security.target.process.command_line, `.*=clear.*`) nocase)

  condition:
    $security
}
