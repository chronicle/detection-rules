rule credentialAccess_accessToBrowserLoginData_windows{
  meta:
    author = "Srijan Kafle"
    description = "Adversaries may acquire credentials from web browsers by reading files specific to the target browser. Web browsers commonly save credentials such as website usernames and passwords so that they do not need to be entered manually in the future. Web browsers typically store the credentials in an encrypted format within a credential store."
    sigma_id = "fc028194-969d-4122-8abe-0470d5b8f12f"
    severity = "MEDIUM"
    created = "2024-02-21"
    product = "microsoft"
    tag = "credential"
    service = "ps_script"
    status = "test"
    Reference = "https://github.com/SigmaHQ/sigma/blob/master/rules/windows/powershell/powershell_script/posh_ps_access_to_browser_login_data.yml"
    mitre = "Credentials from Password Stores: Credentials from Web Browsers,t1555.003"

  events:
    $powershell.metadata.log_type = "POWERSHELL"
    (re.regex($powershell.target.process.command_line, `.*Copy-Item.*`) nocase) and 
    (re.regex($powershell.target.process.command_line, `.*-Destination.*`) nocase) and 
    (re.regex($powershell.target.process.command_line, `.*\\Opera Software\\Opera Stable\\Login Data.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*\\Mozilla\\Firefox\\Profiles.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*\\Microsoft\\Edge\\User Data\\Default.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*\\Google\\Chrome\\User Data\\Default\\Login Data.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*\\Google\\Chrome\\User Data\\Default\\Login Data For Account.*`) nocase)

    $powershell.principal.asset.hostname = $agent

  condition:
    $powershell
}
