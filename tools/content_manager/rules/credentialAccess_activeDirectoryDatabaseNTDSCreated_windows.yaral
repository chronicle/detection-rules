rule credentialAccess_activeDirectoryDatabaseNTDSCreated_windows {
  meta:
    author = "Srijan Kafle"
    description = "Detects creation of a file named 'ntds.dit' (Active Directory Database)"
    severity = "INFO"
    created = "2024-02-06"
    product = "windows"
    tag = "Credential Access,Active Directory"
    service = "process_creation"
    status = "under development"
    Reference = "https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lolbin_gpscript.yml"
    mitre = "OS Credential Dumping: NTDS,t1003.003"

  events:
    
    $security.metadata.event_type = "PROCESS_LAUNCH" and 
    ((re.regex($security.target.process.file.full_path, `.*\\gpscript\.exe`) nocase) or 
    ($security.target.file.full_path = "GPSCRIPT.EXE" nocase)) and 
    (re.regex($security.target.process.command_line, `.* \/logon.*`) nocase or 
    re.regex($security.target.process.command_line, `.* \/startup.*`) nocase) and 
    not ($security.principal.process.command_line = "C:\\windows\\system32\\svchost.exe -k netsvcs -p -s gpsvc" nocase)
  
  condition:
    $security
}
