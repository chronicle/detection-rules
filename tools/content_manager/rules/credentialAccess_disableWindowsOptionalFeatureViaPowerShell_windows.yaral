rule credentialAccess_disableWindowsOptionalFeatureViaPowerShell_windows {
  meta:
    author = "Srijan Kafle"
    description = "Detect built in PowerShell cmdlet Disable-WindowsOptionalFeature, Deployment Image Servicing and Management tool. Similar to DISM.exe, this cmdlet is used to enumerate, install, uninstall, configure, and update features and packages in Windows images"
    sigma_id = "99c4658d-2c5e-4d87-828d-7c066ca537c3"
    severity = "HIGH"
    created = "2024-02-27"
    product = "microsoft"
    tag = "credential"
    service = "ps_script"
    status = "test"
    Reference = "https://github.com/SigmaHQ/sigma/tree/master/rules/windows/powershell/powershell_script/posh_ps_disable_windows_optional_feature.yml"
    mitre = "OS Credential Dumping,t1562.001"

  events:
    (re.regex($powershell.target.process.command_line, `.*Disable-WindowsOptionalFeature.*`) nocase) and 
    (re.regex($powershell.target.process.command_line, `.*-Online.*`) nocase) and 
    (re.regex($powershell.target.process.command_line, `.*-FeatureName.*`) nocase) and 
    (re.regex($powershell.target.process.command_line, `.*Windows-Defender-Gui.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*Windows-Defender-Features.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*Windows-Defender.*`) nocase or 
    re.regex($powershell.target.process.command_line, `.*Windows-Defender-ApplicationGuard.*`) nocase)

    outcome:
        $risk_score = 90

  condition:
    $powershell
}



