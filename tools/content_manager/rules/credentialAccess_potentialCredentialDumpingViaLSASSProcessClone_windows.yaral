rule credentialAccess_potentialCredentialDumpingViaLSASSProcessClone_windows {

  meta:
    author = "Srijan Kafle"
    description = "Detects a suspicious LSASS process clone that could be a sign of credential dumping activity"
    severity = "INFO"
    created = "2024-01-09"
    product = "microsoft"
    tag = "sysmon"
    service = "command"
    status = "under development"
    mitre = "OS Credential Dumping,t1003"
    Reference = "https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_lsass_process_clone.yml"

  events:
    $sysmon.metadata.event_type = "PROCESS_LAUNCH"
    $sysmon.principal.process.file.full_path = /\\Windows\\System32\\lsass\.exe$/ nocase AND $sysmon.target.process.file.full_path = /\\Windows\\System32\\lsass\.exe$/ nocase


  condition:
    $sysmon
}
