rule credentialAccess_suspiciousSYSVOLDomainGroupPolicyAccess_windows{
 meta:
    author = "Ruledev2"
    description = "Detects Access to Domain Group Policies stored in SYSVOL"
    severity = "MEDIUM"
    created = "2024-02-4"
    product = "microsoft"
    tag = "credential_access"
    service = "process_creation"
    status = "under development"
    Reference = "https://github.com/SigmaHQ/sigma/tree/master/rules/windows/process_creation/proc_creation_win_susp_sysvol_access.yml"
    mitre = "Unsecured Credentials: Group Policy Preferences,t1552.006"

  events:
    $security.metadata.event_type = "PROCESS_LAUNCH" and 
    (re.regex($security.target.process.command_line, `.*\\SYSVOL\\.*`) nocase) and 
    (re.regex($security.target.process.command_line, `.*\\policies\\.*`) nocase)
    
    not $security.target.process.command_line = "C:\\Windows\\system32\\cmd.exe /c \"\"\\\\natstor.local\\SysVol\\natstor.local\\Policies\\{F06CAEC1-CC87-44AD-8D06-5F47FC249ECB}\\Machine\\scripts\\startup\\ninja_client_install.bat\" \"" nocase //SENG-879


  condition:
    $security
}
