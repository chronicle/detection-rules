rule defenseEvasion_hackToolCrackMapExecPowershellObfuscation_windows{
  meta:
    author = "Srijan Kafle"
    description = "The CrachMapExec pentesting framework implements a PowerShell obfuscation with some static strings detected by this rule."
    severity = "HIGH"
    created = "2024-02-12"
    product = "microsoft"
    tag = "execution,compromise"
    service = "process_monitor"
    status = "test"
    Reference = "https://github.com/SigmaHQ/sigma/tree/master/rules/windows/process_creation/proc_creation_win_hktl_crackmapexec_powershell_obfuscation.yml"
    mitre = "Command and Scripting Interpreter: PowerShell,t1059.001;Obfuscated Files or Information: Indicator Removal from Tools,t1027.005"

  events:

    $process.metadata.event_type = "PROCESS_LAUNCH" and 
    ($process.target.process.file.full_path = /\\powershell\.exe|\\pwsh\.exe/ nocase OR $process.target.process.file.names = /PowerShell.EXE|pwsh.dll/ nocase) AND $process.target.process.command_line = /join.*split|\( \$ShellId\[1\]\+\$ShellId\[13\]\+'x'\)|\( \$PSHome\[.*\]\+\$PSHOME\[.*\]\+|\( \$env:Public\[13\]\+\$env:Public\[5\]\+'x'\)|\( \$env:ComSpec\[4,.*,25\]-Join''\)|\[1,3\]\+'x'-Join''\)/ nocase
    outcome:
    $risk_score = 90

  condition:
    $process
}
