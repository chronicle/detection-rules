rule new_firewall_rule_added_via_netshexe_windows {
 meta:
    author = "Nayan Bhattarai"
    description = "Detects the addition of a new rule to the Windows firewall via netsh"
    license = "DRL 1.1"
    reference = "https://web.archive.org/web/20190508165435/https://www.operationblockbuster.com/wp-content/uploads/2016/02/Operation-Blockbuster-RAT-and-Staging-Report.pdf"
    version = "0.01"
    rule_id = "cd5cfd80-aa5f-44c0-9c20-108c4ae12e3c"
    status = "test"
    tags = "attack.defense-evasion, attack.s0246, attack.t1562.004"
    falsepositives = "Legitimate administration activity, Software installations"
    severity = "medium"
    created = "2025-04-15"

  events:
   $security.metadata.event_type = "PROCESS_LAUNCH" and 
    ((re.regex($security.target.process.file.full_path, `.*\\netsh\.exe`) nocase) or 
    ($security.target.file.full_path = "netsh.exe" nocase)) and 
    (re.regex($security.target.process.command_line, `.* firewall .*`) nocase) and 
    (re.regex($security.target.process.command_line, `.* add .*`) nocase) and 
    not ((re.regex($security.target.process.command_line, `.*advfirewall firewall add rule name=Dropbox dir=in action=allow \"program=\?:\\Program Files \(x86\)\\Dropbox\\Client\\Dropbox\.exe\" enable=yes profile=Any.*`) nocase or 
    re.regex($security.target.process.command_line, `.*advfirewall firewall add rule name=Dropbox dir=in action=allow \"program=\?:\\Program Files\\Dropbox\\Client\\Dropbox\.exe\" enable=yes profile=Any.*`) nocase))

    //Whitelist
    not $security.principal.process.file.full_path = "C:\\Program Files (x86)\\N-able Technologies\\Windows Software Probe\\bin\\wsp.exe" and 
    $security.target.process.command_line = "\"netsh.exe\" advfirewall firewall add rule name=\"WSP\" dir=in protocol=TCP localport=10004 action=allow"



  condition:
    $security
}
