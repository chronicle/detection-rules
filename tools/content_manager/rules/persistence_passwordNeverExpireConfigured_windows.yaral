rule persistence_passwordNeverExpireConfigured_windows {
 meta:
    author = "Srijan Kafle"
    description = "Detects the creation and modification of an account with the Don't Expire Password option Enabled. Attackers can abuse this misconfiguration to persist in the domain and maintain long-term access using compromised accounts with this property."
    mitre = "attack.account-manipulation, attack.T1098.0003"
    falsepositives = "None"
    severity = "High"
    created = "2024-09-03"
    product = "microsoft"
    reference = "https://detection.fyi/elastic/detection-rules/windows/persistence_dontexpirepasswd_account/?query=expire"

  events:
    $security.metadata.product_event_type = "4738"
    $security.target.resource.attribute.labels.value = "%%2089"

  condition:
    $security
}
