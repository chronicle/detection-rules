rule renamedSystemBinaryusage_windows {
  meta:
    author = "Srijan Kafle"
    description = "Detects the execution of a renamed system binary executable often used by attackers or malware"
    sigma_id = "4a0b2c7e-7cb2-495d-8b63-5f268e7bfd67, e6474a1b-5390-49cd-ab41-8d88655f7394"
    severity = "HIGH"
    created = "2024-03-04"
    product = "microsoft"
    tag = "credential"
    service = "ps_script"
    status = "test"
    technique = "Defense Evasion,TA005"
    Reference = "https://github.com/SigmaHQ/sigma/tree/master/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_procdump.yml, https://github.com/SigmaHQ/sigma/tree/master/rules/windows/process_creation/proc_creation_win_renamed_mavinject.yml"
    mitre = "Masquerading: Rename System Utilities,t1036.003"

  events:
    $security.metadata.event_type = "PROCESS_LAUNCH" and 
    (($security.target.file.full_path = "procdump" nocase) or 
    ((re.regex($security.target.process.command_line, `.* -ma .*`) nocase or 
    re.regex($security.target.process.command_line, `.* \/ma .*`) nocase or 
    re.regex($security.target.process.command_line, `.* -mp .*`) nocase or 
    re.regex($security.target.process.command_line, `.* \/mp .*`) nocase) and 
    (re.regex($security.target.process.command_line, `.* -accepteula.*`) nocase or 
    re.regex($security.target.process.command_line, `.* \/accepteula.*`) nocase))) and 
    not ((re.regex($security.target.process.file.full_path, `.*\\procdump\.exe`) nocase or 
    re.regex($security.target.process.file.full_path, `.*\\procdump64\.exe`) nocase))

  condition:
    $security
}
