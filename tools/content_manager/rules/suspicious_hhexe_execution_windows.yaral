rule suspicious_hhexe_execution_windows {
 meta:
    author = "Nayan Bhattarai"
    description = "Detects a suspicious execution of a Microsoft HTML Help (HH.exe)."
    license = "https://github.com/Neo23x0/sigma/blob/master/LICENSE.Detection.Rules.md"
    reference = "https://www.trustwave.com/en-us/resources/blogs/spiderlabs-blog/chm-badness-delivers-a-banking-trojan/, https://github.com/elastic/protections-artifacts/commit/746086721fd385d9f5c6647cada1788db4aea95f#diff-27939090904026cc396b0b629c8e4314acd6f5dac40a676edbc87f4567b47eb7, https://www.ptsecurity.com/ww-en/analytics/pt-esc-threat-intelligence/higaisa-or-winnti-apt-41-backdoors-old-and-new/, https://www.zscaler.com/blogs/security-research/unintentional-leak-glimpse-attack-vectors-apt37"
    version = "0.01"
    sigma_id = "e8a95b5e-c891-46e2-b33a-93937d3abc31"
    status = "test"
    tags = "attack.defense-evasion, attack.execution, attack.initial-access, attack.t1047, attack.t1059.001, attack.t1059.003, attack.t1059.005, attack.t1059.007, attack.t1218, attack.t1218.001, attack.t1218.010, attack.t1218.011, attack.t1566, attack.t1566.001"
    falsepositives = "Unknown"
    severity = "high"
    created = "2025-12-15"
    category = "process_creation"
    product = "windows"

  events:
    $process_creation.metadata.event_type = "PROCESS_LAUNCH" and 
    (($process_creation.target.file.full_path = "HH.exe" nocase) or 
    (re.regex($process_creation.target.process.file.full_path, `.*\\hh\.exe`) nocase)) and 
    (re.regex($process_creation.target.process.command_line, `.*\.application.*`) nocase or 
    re.regex($process_creation.target.process.command_line, `.*\\AppData\\Local\\Temp\\.*`) nocase or 
    re.regex($process_creation.target.process.command_line, `.*\\Content\.Outlook\\.*`) nocase or 
    re.regex($process_creation.target.process.command_line, `.*\\Downloads\\.*`) nocase or 
    re.regex($process_creation.target.process.command_line, `.*\\Users\\Public\\.*`) nocase or 
    re.regex($process_creation.target.process.command_line, `.*\\Windows\\Temp\\.*`) nocase)

  condition:
    $process_creation
}
