rule suspicious_zipexec_execution {
 meta:
    author = "Nayan Bhattarai"
    description = "ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected zip file.."
    license = "https://github.com/Neo23x0/sigma/blob/master/LICENSE.Detection.Rules.md"
    reference = "https://twitter.com/SBousseaden/status/1451237393017839616, https://github.com/Tylous/ZipExec"
    version = "0.01"
    sigma_id = "90dcf730-1b71-4ae7-9ffc-6fcf62bd0132"
    status = "test"
    tags = "attack.execution, attack.defense-evasion, attack.t1218, attack.t1202"
    falsepositives = "Unknown"
    severity = "medium"
    created = "2021-11-07"
    category = "process_creation"
    product = "windows"

  events:
    $process.metadata.event_type = "PROCESS_LAUNCH" and 
    (((re.regex($process.target.process.command_line, `.*\/generic:Microsoft_Windows_Shell_ZipFolder:filename=.*`) nocase) and 
    (re.regex($process.target.process.command_line, `.*\.zip.*`) nocase) and 
    (re.regex($process.target.process.command_line, `.*\/pass:.*`) nocase) and 
    (re.regex($process.target.process.command_line, `.*\/user:.*`) nocase)) or 
    ((re.regex($process.target.process.command_line, `.*\/delete.*`) nocase) and 
    (re.regex($process.target.process.command_line, `.*Microsoft_Windows_Shell_ZipFolder:filename=.*`) nocase) and 
    (re.regex($process.target.process.command_line, `.*\.zip.*`) nocase)))

  condition:
    $process
}
